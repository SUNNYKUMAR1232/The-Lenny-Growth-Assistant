# =============================================================================
# Lenny Growth Assistant — environment configuration
# Copy to `.env` and adjust. `.env` is gitignored; never commit real keys.
# =============================================================================

# ---- App --------------------------------------------------------------------
APP_ENV=local                     # local | docker | test | production
LOG_LEVEL=INFO                    # DEBUG for verbose pipeline tracing
LOG_FORMAT=json                   # json (machine-parseable) | console (pretty)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Database (REQUIRED) ----------------------------------------------------
# Local (host Postgres):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lenny
# Docker Compose uses: postgresql+asyncpg://postgres:postgres@postgres:5432/lenny
# Supabase/Railway: paste their connection string and swap the driver to +asyncpg.

# ---- Model provider ---------------------------------------------------------
# ollama = local model (REQUIRED for the demo) | cloud = Anthropic/OpenAI
# stub   = deterministic test double, CI only — never for a demo
LLM_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434
# From inside Docker Compose use: http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

CLOUD_PROVIDER=anthropic          # anthropic | openai
CLOUD_MODEL=claude-sonnet-4-5
ANTHROPIC_API_KEY=                # required only when LLM_PROVIDER=cloud
OPENAI_API_KEY=                   # required only when CLOUD_PROVIDER=openai
# OPENAI_BASE_URL=                # optional: OpenAI-compatible gateway

LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TEMPERATURE=0.3

# ---- Embeddings -------------------------------------------------------------
# ollama = nomic-embed-text (768d, recommended)
# openai = text-embedding-3-small
# hash   = deterministic fallback, NOT semantic — tests/CI only
EMBEDDING_PROVIDER=ollama
EMBEDDING_DIM=768                 # changing this requires a new migration + re-ingest
EMBEDDING_BATCH_SIZE=16
EMBEDDING_ALLOW_FALLBACK=true     # degrade to `hash` instead of failing a request

# ---- Retrieval --------------------------------------------------------------
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATE_K=30
RETRIEVAL_VECTOR_WEIGHT=0.6
RETRIEVAL_KEYWORD_WEIGHT=0.4
RETRIEVAL_RRF_K=60
RETRIEVAL_MIN_VECTOR_SIMILARITY=0.05   # junk floor for the vector leg; raise for high-similarity embedders
EPISODE_CONTEXT_MAX_CHUNKS=6
EPISODE_CONTEXT_MAX_EPISODES=3

# ---- Memory -----------------------------------------------------------------
MEMORY_ENABLED=true
MEMORY_MIN_CONFIDENCE=0.6
MEMORY_MIN_IMPORTANCE=0.4
MEMORY_TOP_K=5
MEMORY_MAX_PER_USER=200
MEMORY_EXTRACT_EVERY_N_TURNS=2

# ---- Grounding --------------------------------------------------------------
GROUNDING_ENABLED=true
GROUNDING_MIN_SUPPORT=0.28        # per-claim lexical support threshold
GROUNDING_MIN_SUPPORTED_RATIO=0.5 # below this, the answer is flagged in the UI

# ---- Ingestion --------------------------------------------------------------
TRANSCRIPTS_DIR=./data/transcripts
SKILLS_DIR=./skills               # SKILL.md files are read at request time, not baked in
CHUNK_TARGET_TOKENS=350
CHUNK_OVERLAP_TOKENS=60

# ---- Artifacts --------------------------------------------------------------
ARTIFACT_MAX_BYTES=400000

# ---- Frontend (read by Next.js at build/run time) ---------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
